# ===================================================================
# Car Rental Application - Environment Configuration
# ===================================================================

# 1. Live Backend API Base URL
# Change this to your backend server port and API path
# Examples:
# - Spring Boot: http://localhost:8080/api
# - Node.js/Express: http://localhost:5000/api
# - Python FastAPI/Django: http://localhost:8000/api
# - ASP.NET Core: http://localhost:5001/api
VITE_API_BASE_URL=http://localhost:8080/api

# 2. Toggle Mock Mode vs Live Backend
# - Set to "false" to send all API requests to your live backend server
# - Set to "true" (or omit) to use the built-in standalone mock adapter
VITE_USE_MOCK=false
